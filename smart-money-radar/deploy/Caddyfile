# Automatic HTTPS (Let's Encrypt) for DOMAIN. With DOMAIN=localhost Caddy uses its own local CA.
{$DOMAIN:localhost} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}
	# API + WebSocket go straight to the backend; everything else to the dashboard
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
	log {
		output stdout
		format console
	}
}
