# Smart Money Radar - copy to .env and fill in. NEVER put a private key or seed phrase here:
# the application only reads public blockchain data and never signs anything.

# ---------- required ----------
# Domain pointing at this server (A record). Caddy obtains the HTTPS certificate automatically.
# Use "localhost" for a local test (self-signed local CA).
DOMAIN=localhost
# Dashboard password (long, random). Login is rate limited.
DASHBOARD_PASSWORD=
# Random secret for signing session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Database password, e.g. `openssl rand -hex 16`
POSTGRES_PASSWORD=
POSTGRES_USER=radar
POSTGRES_DB=radar
# Public URL used in Telegram links (optional)
PUBLIC_URL=https://localhost

# ---------- strongly recommended ----------
# Helius (https://dashboard.helius.dev): faster RPC + websocket, getTokenLargestAccounts
# (holder concentration). Without it the public Solana RPC is used (rate limited, slower backfill).
HELIUS_API_KEY=
# requests/second allowed by YOUR Helius plan (see the Helius dashboard); 8 is safe for the free plan
HELIUS_RPS=8
# Other private RPC URLs, comma separated (Triton, QuickNode, ...), used after Helius
SOLANA_RPC_URLS=
SOLANA_RPC_RPS=5
# Use api.mainnet-beta.solana.com + solana-rpc.publicnode.com as fallback
USE_PUBLIC_RPC=true

# ---------- Telegram alerts (official Bot API) ----------
# @BotFather -> /newbot -> token. Then send /start to your bot: it replies with your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- optional (not required by any feature) ----------
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=
PUMPPORTAL_API_KEY=

# ---------- operations ----------
LOG_LEVEL=INFO
LOG_JSON=true
SESSION_TTL_HOURS=336
BACKUP_KEEP_DAYS=14
# 19:30 UTC = 02:30 Vietnam time
BACKUP_AT_UTC=19:30

# ---------- Windows / local PC mode (docker-compose.windows.yml) ----------
# Dashboard address: http://localhost:LOCAL_PORT . Keep LOCAL_BIND=127.0.0.1 (only this computer);
# 0.0.0.0 opens it to your home Wi-Fi (plain HTTP - never forward this port on the router).
LOCAL_PORT=8080
LOCAL_BIND=127.0.0.1

# Optional remote access (see docs/windows.md, section "Truy cap tu xa"):
# Cloudflare Tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels (public hostname -> http://caddy:80)
CLOUDFLARE_TUNNEL_TOKEN=
