# Copy this file to .env (next to run_windows.bat or next to SOL_Memecoin_Hunter.exe)
# NEVER put a private key or seed phrase here — the app never needs one.

# --- Not needed (no such key exists as of 2026-09) ---
# Pump.fun has no official public API / API key. DexScreener's public API needs no key.
PUMPFUN_API_KEY=
DEXSCREENER_API_KEY=

# --- Strongly recommended (free tier is enough): holder count + top 50 holders ---
# https://dashboard.helius.dev  -> API Keys
HELIUS_API_KEY=

# Optional: any other private Solana RPC URL (used after Helius, before the public RPC)
SOLANA_RPC_URL=

# --- Telegram alerts (official Bot API) ---
# 1) Talk to @BotFather -> /newbot -> copy token
# 2) Send any message to your bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates -> chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 2 (not used yet) ---
BIRDEYE_API_KEY=
# X API v2 bearer token (paid tier needed for search)
X_API_KEY=
X_BEARER_TOKEN=
# Telegram user API for reading channels you joined (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
